<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- WeatherKit API -->
    <!-- 実機テスト用に一時無効化（Developer Program 加入後に復元すること）
    <key>com.apple.developer.weatherkit</key>
    <true/>
    -->

    <!-- iCloud Key-Value Store (お気に入り・踏破データの同期) -->
    <key>com.apple.developer.ubiquity-kvs-identifier</key>
    <string>$(TeamIdentifierPrefix)*</string>

    <!-- iCloud Document Storage (フォトアルバムの同期) -->
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.com.osprey74.michi-navi</string>
    </array>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudDocuments</string>
    </array>
</dict>
</plist>
